# DailyNest — Environment Configuration
# ========================================================
# Google OAuth 2.0 Client ID for Real Google Authentication
#
# HOW TO OBTAIN:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web Application).
# 3. Add Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://localhost:3000
# 4. Copy the Client ID below:
# ========================================================

VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# NOTE: If this is left unconfigured, DailyNest operates normally with local email/password authentication
# and displays a helpful configuration guide modal when the Google button is clicked.
